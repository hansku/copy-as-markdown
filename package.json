{
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"lint": "xo source",
		"version": "dot-json distribution/manifest.json version $VER",
		"release:cws": "webstore upload --source=distribution --auto-publish",
		"release:amo": "web-ext-submit --source-dir distribution",
		"release": "VER=$(daily-version) run-s build version release:*"
	},
	"devDependencies": {
		"@crxjs/vite-plugin": "^2.0.0-beta.23",
		"@types/chrome": "^0.0.263",
		"@types/node": "^20.12.7",
		"@types/turndown": "^5.0.4",
		"chrome-webstore-upload-cli": "^1.2.0",
		"daily-version": "^1.0.0",
		"dot-json": "^1.2.0",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.4.5",
		"vite": "^5.2.8",
		"web-ext": "^4.1.0",
		"web-ext-submit": "^4.1.0",
		"xo": "^0.28.1"
	},
	"dependencies": {
		"mathml-to-latex": "^1.5.0",
		"turndown": "^7.2.0",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"xo": {
		"envs": [
			"browser",
			"webextensions"
		],
		"ignores": [
			"distribution",
			"vite.config.ts"
		],
		"rules": {
			"unicorn/string-content": "off",
			"import/no-unassigned-import": "off"
		}
	}
}